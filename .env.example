# Copy to .env and fill in. NEVER commit .env.
# These are the only supported sources of secrets/configuration.

# --- Discord ---
DISCORD_TOKEN=
# Leave the unused guild ID blank (blank means "unset").
DISCORD_GUILD_ID=
DISCORD_TEST_GUILD_ID=

# --- GitHub ---
GITHUB_TOKEN=
GITHUB_ORG=

# --- Community repo ---
# Absolute path to a local checkout of the private community repository.
COMMUNITY_REPO_PATH=

# --- LLM (one OpenAI-compatible provider, behind commons/llm.py) ---
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
# Optional explicit USD pricing per 1M tokens for models not in the built-in table.
LLM_INPUT_PRICE_PER_MTOK=
LLM_OUTPUT_PRICE_PER_MTOK=
# DeepSeek: thinking mode is on by default and spends output tokens on reasoning.
# Set disabled for these short JSON tasks.
LLM_THINKING=

# --- Runtime ---
# Rebuildable state (SQLite, cache, logs). Must NOT live inside COMMUNITY_REPO_PATH.
RUNTIME_DIR=runtime
LOG_LEVEL=INFO
